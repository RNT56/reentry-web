APP_ORIGIN=https://stocks.example.com
APP_PORT=4173
REGISTRATION_OPEN=true
# Only for the optional Docker-network Caddy override:
CADDY_NETWORK=caddy

# Generate once: openssl rand -base64 32. Back up separately from the database.
AI_MASTER_KEY=
ENABLE_BACKGROUND_JOBS=false
# Exact existing Reentry usernames, comma-separated. No account is an author by default.
AUTHOR_USERNAMES=
AUTHOR_PUBLIC_NAME=RNT
# SEC requires an application identity and real operator contact.
SEC_USER_AGENT=
