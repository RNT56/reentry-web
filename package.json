{
  "name": "reentry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch server/index.js",
    "start": "node server/index.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "backup": "node scripts/backup.mjs",
    "check": "eslint src server scripts tests eslint.config.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "fastify": "5.12.8",
    "hyparquet": "1.33.0",
    "hyparquet-compressors": "1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@levischuck/tiny-cbor": "0.2.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24"
  }
}
