{
  "name": "reentry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch server/index.js",
    "start": "node server/index.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "backup": "node scripts/backup.mjs",
    "check": "node --check src/app.js && node --check server/app.js && node --check server/auth.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "0.2.11",
    "esbuild": "0.28.2",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24"
  }
}
